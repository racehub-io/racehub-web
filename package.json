{
  "name": "racehub-web",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "@racehub-io/f1-telemetry-client": "0.3.0",
    "@visx/responsive": "^3.10.2",
    "hyparquet": "1.31.4",
    "hyparquet-compressors": "1.1.2",
    "proper-lockfile": "4.1.2",
    "protobufjs": "8.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.4",
    "react-redux": "7.2.9",
    "react-router-dom": "5.3.4",
    "redux": "4.2.1",
    "typesafe-actions": "5.1.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "collector": "node server/index.mjs",
    "build": "npm run type-check && vite build",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "check": "npm run type-check && npm test",
    "preview": "vite preview --host 127.0.0.1",
    "build:pages": "npm run type-check && vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "Free, open source local telemetry recording and analysis for F1, iRacing and rFactor 2.",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-router-dom": "^5.3.3",
    "sass": "1.105.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "path-to-regexp": "1.9.0"
  }
}
